# ==============================================================================
# ThinkSpace — Interactive Communication and Critical Thinking Platform
# Unified Root Environment Configuration Reference
# ==============================================================================
# For service-specific details, refer to:
#   - backend/.env.example
#   - frontend/.env.example
#   - ml/.env.example
#
# QUICK START ZERO-CONFIG MODE:
# ThinkSpace is engineered with built-in fallbacks:
# 1. MongoDB: automatically uses in-memory MongoDB + auto-seeded topics if no URI is set.
# 2. Redis: automatically uses high-efficiency in-memory cache if Redis is absent.
# 3. AI: automatically uses built-in ThinkSpace Coach if external LLM keys are absent.
# ==============================================================================

# Backend (Port 5000)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/thinkspace
REDIS_URL=redis://localhost:6379
JWT_SECRET=thinkspace-super-secure-jwt-secret-key-32chars-minimum!
JWT_EXPIRY=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
FRONTEND_URL=http://localhost:3000,http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your_ml_api_key_here

# AI Service Keys (Optional — ThinkSpace Coach operates locally if omitted)
GROQ_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frontend (Port 3000 / 5173)
REACT_APP_API_URL=http://localhost:5000
REACT_APP_WS_URL=http://localhost:5000

# ML Microservice (Port 8000)
USE_LOCAL_STT=true
USE_LOCAL_TTS=false
USE_LOCAL_MEMORY=true
