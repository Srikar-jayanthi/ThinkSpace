# ============================================================
# ThinkSpace Backend Environment Configuration
# ============================================================

# ── Deployment ──
NODE_ENV=development
PORT=5000

# ── Database ──
# If omitted or unavailable in development, ThinkSpace automatically launches
# an in-memory MongoDB instance and auto-seeds 23 practice topics.
MONGODB_URI=mongodb://localhost:27017/thinkspace

# ── Cache & Session Store (optional) ──
# If Redis is omitted or unreachable, ThinkSpace automatically falls back
# to a high-performance in-memory store with TTL and sorted sets.
REDIS_URL=redis://localhost:6379

# ── Security & Authentication ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=thinkspace-super-secure-jwt-secret-key-32chars-minimum!
JWT_EXPIRY=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Email Service (optional) ──
# If not configured, verification codes & OTPs will log safely to stdout.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@thinkspace.edu

# ── AI Providers (optional cascading failover) ──
# Failover sequence: Sarvam AI (Indian languages) -> Groq -> OpenAI -> Ollama -> Built-in ThinkSpace Coach
# Even with zero keys provided, ThinkSpace Coach ensures 100% operational practice arenas!
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Local Ollama Fallback (optional) ──
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Text-To-Speech (optional) ──
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ── ML Microservice (FastAPI NLP analysis) ──
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your_secure_ml_api_key_here

# ── CORS Origins ──
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# ── Push Notifications (VAPID) ──
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:support@thinkspace.edu
